# ============================================================
# CONFIGURACAO DO SUPABASE EXTERNO - MRO Project
# ============================================================
# Copie este arquivo para .env e preencha com as credenciais
# do seu projeto Supabase externo.
# ============================================================

# ---- SUPABASE EXTERNO (OBRIGATORIO) ----

# URL do projeto (ex: https://xxxxx.supabase.co)
VITE_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co

# Chave publica (publishable key) - visivel no dashboard
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Referencia do projeto (ex: xbcdefghijklmnopqrstu)
SUPABASE_PROJECT_REF=SEU_PROJECT_REF

# Access Token (gerado em: Supabase Dashboard > Settings > API > Personal Access Tokens)
SUPABASE_ACCESS_TOKEN=sb-PAT-xxxxxxxxxxxxx

# Senha do banco Postgres (a mesma usada no dashboard do Supabase)
POSTGRES_PASSWORD=SUA_SENHA_DO_BANCO

# ---- APIS EXTERNAS (EDGE FUNCTIONS) ----

# OpenAI (para Agente IA e transcricao de audio)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxx

# Meta/Facebook (WhatsApp Business API)
META_ACCESS_TOKEN=EAAxxxxxxxxxxxxx
META_PHONE_NUMBER_ID=SEU_PHONE_NUMBER_ID
META_WABA_ID=SEU_WABA_ID

# Google OAuth (sincronizacao de contatos)
GOOGLE_CLIENT_ID=474898024942-xxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=SEU_GOOGLE_CLIENT_SECRET

# ---- SERVIÇOS DE PAGAMENTO ----

# Stripe
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# Pagar.me / InfinitePay
INFINITEPAY_API_KEY=sk_live_xxxxxxxxxxxxx

# ---- VARIAVEIS OPCIONAIS ----

# VPS Transcoder (se usar transcricao de audio via VPS)
VPS_TRANSCODER_URL=https://seu-vps.com/transcribe

# URL do site em producao
SITE_URL=https://seu-dominio.com

# Modo de ambiente
NODE_ENV=production

# ---- ADMIN CENTRAL (/admincentral) ----
# Opcional. Se nao definir, usa o e-mail padrao do projeto.
# VITE_ADMIN_CENTRAL_EMAIL=mro@gmail.com
# Hash SHA-256 da senha (gere com: echo -n 'SUA_SENHA' | sha256sum)
# VITE_ADMIN_CENTRAL_PASSWORD_SHA256=
